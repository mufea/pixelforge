# PixelForge AI — environment variables
# Copy to .env.local for Next.js and .env for Docker Compose / worker.
# Never commit real secrets. Empty values mean "not configured".

# --- Application ---
NODE_ENV=development
APP_NAME=PixelForge AI
APP_URL=http://127.0.0.1:43127
LOG_LEVEL=info

# Mock AI providers are allowed only when NODE_ENV=test, or when
# NODE_ENV=development AND AI_PROVIDER_MODE=mock. Production ignores mock mode.
AI_PROVIDER_MODE=live

# Enable the versioned public REST API after the core studio is stable.
PUBLIC_API_ENABLED=false

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://pixelforge:pixelforge@127.0.0.1:5432/pixelforge?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=pixelforge
JOB_DEFAULT_TIMEOUT_MS=180000
USER_CONCURRENCY_LIMIT=2
PROVIDER_OPENAI_RPM=30
PROVIDER_GOOGLE_RPM=20
PROVIDER_FAL_RPM=30

# --- Authentication (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:43127
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery. In development, unset credentials log verification links.
EMAIL_FROM=PixelForge AI <noreply@localhost>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Object storage (S3-compatible). MinIO is the local default. ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=pixelforge-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_UPLOAD_TTL_SECONDS=300
S3_PRESIGN_DOWNLOAD_TTL_SECONDS=120

# Upload and processing limits
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_EDGE_PX=8192
STORAGE_QUOTA_BYTES=1073741824
ZIP_EXPORT_MAX_FILES=50
ZIP_EXPORT_MAX_BYTES=104857600

# --- AI providers (server-side only; never prefix with NEXT_PUBLIC_) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=120000

GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_AI_TIMEOUT_MS=120000

# Official Fal env name is FAL_KEY. FAL_API_KEY is accepted as an alias.
FAL_KEY=
FAL_API_KEY=
FAL_TIMEOUT_MS=120000

# Stability AI REST v2beta. Never prefix with NEXT_PUBLIC_.
STABILITY_API_KEY=
STABILITY_BASE_URL=https://api.stability.ai
STABILITY_TIMEOUT_MS=120000

# --- Payments ---
# Credits are granted only after verified, idempotent webhook processing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=

# --- Cost control ---
# Hard stop when estimated provider spend (USD cents) exceeds this in a UTC day.
DAILY_PROVIDER_BUDGET_USD_CENTS=5000
# Emergency kill switch: disable all billable AI jobs.
AI_JOBS_ENABLED=true

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
